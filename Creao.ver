// Gallery render
function renderGallery() {
  const grid = document.getElementById('gallery-grid');
  grid.innerHTML = cats.map(cat => `
    <div class="gallery-card" onclick="switchToMapAndSelect(${cat.id})">
      <img class="gallery-card-img" src="${cat.img}" alt="${cat.name}" onerror="this.src='data:image/svg+xml,<svg xmlns=\\'http://www.w3.org/2000/svg\\' width=\\'260\\' height=\\'200\\'><rect width=\\'260\\' height=\\'200\\' fill=\\'${encodeURIComponent(cat.color)}\\'/><text x=\\'130\\' y=\\'110\\' text-anchor=\\'middle\\' font-size=\\'60\\'>🐱</text></svg>'"/>
      <div class="gallery-card-body">
        <div class="gallery-card-name">${cat.name}</div>
        <div class="gallery-card-sub">${cat.nickname}</div>
        <div class="gallery-card-tags">
          <span class="gallery-tag">${cat.breed}</span>
          <span class="gallery-tag">${cat.gender}</span>
          <span class="gallery-tag">${cat.age}</span>
          ${cat.badges.map(b => `<span class="gallery-tag">${b}</span>`).join('')}
        </div>
      </div>
    </div>
  `).join('');
}

function switchToMapAndSelect(id) {
  switchView('map');
  setTimeout(() => selectCat(id), 100);
}

// Relation graph render
function renderRelations() {
  const svg = document.getElementById('relation-svg');
  const W = svg.clientWidth || 900, H = svg.clientHeight || 500;
  
  const positions = [
    { x: W*0.2, y: H*0.7 },   // 橘福
    { x: W*0.6, y: H*0.6 },   // 雪团
    { x: W*0.25, y: H*0.3 },  // 月月
    { x: W*0.15, y: H*0.55 }, // 茶叶
    { x: W*0.8, y: H*0.55 },  // 豆豆
    { x: W*0.55, y: H*0.3 },  // 小煤球
  ];

  const relColors = { "好朋友": "#FF6B6B", "家族关系": "#A855F7", "竞争对手": "#94A3B8", "共同领地": "#22C55E", "认识": "#CBD5E1" };
  const relDash = { "竞争对手": "8,4", "认识": "4,4" };

  let svgContent = `
    <defs>
      <filter id="glow"><feGaussianBlur stdDeviation="3" result="coloredBlur"/><feMerge><feMergeNode in="coloredBlur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
      <radialGradient id="bgGrad" cx="50%" cy="50%" r="50%">
        <stop offset="0%" style="stop-color:#F0EAFF"/>
        <stop offset="100%" style="stop-color:#E8E0FF"/>
      </radialGradient>
    </defs>
    <rect width="100%" height="100%" fill="url(#bgGrad)"/>
    <text x="${W/2}" y="36" text-anchor="middle" font-size="20" font-weight="bold" fill="#4A0FA8" font-family="sans-serif">🐾 清华校园猫咪关系图谱</text>
  `;

  // Draw edges
  const drawn = new Set();
  cats.forEach(cat => {
    cat.relations.forEach(rel => {
      const key = [Math.min(cat.id,rel.catId), Math.max(cat.id,rel.catId)].join('-');
      if (drawn.has(key)) return;
      drawn.add(key);
      const p1 = positions[cat.id], p2 = positions[rel.catId];
      const color = relColors[rel.type] || '#999';
      const dash = relDash[rel.type] ? `stroke-dasharray="${relDash[rel.type]}"` : '';
      const mx = (p1.x + p2.x)/2, my = (p1.y + p2.y)/2;
      svgContent += `<line x1="${p1.x}" y1="${p1.y}" x2="${p2.x}" y2="${p2.y}" stroke="${color}" stroke-width="3" ${dash} opacity="0.7"/>`;
      svgContent += `<rect x="${mx-32}" y="${my-11}" width="64" height="18" rx="9" fill="white" opacity="0.85"/>`;
      svgContent += `<text x="${mx}" y="${my+3}" text-anchor="middle" font-size="10" fill="${color}" font-weight="600" font-family="sans-serif">${rel.type}</text>`;
    });
  });

  // Draw nodes
  cats.forEach((cat, i) => {
    const p = positions[i];
    svgContent += `
      <g class="cat-marker" onclick="switchToMapAndSelect(${cat.id})" style="cursor:pointer">
        <circle cx="${p.x}" cy="${p.y}" r="46" fill="${cat.color}" opacity="0.15" filter="url(#glow)"/>
        <circle cx="${p.x}" cy="${p.y}" r="40" fill="white" stroke="${cat.color}" stroke-width="3"/>
        <image href="${cat.img}" x="${p.x-30}" y="${p.y-40}" width="60" height="60" clip-path="circle(28px at 30px 30px)"
          onerror=""/>
        <text x="${p.x}" y="${p.y+50}" text-anchor="middle" font-size="14" font-weight="bold" fill="${cat.color}" font-family="sans-serif">${cat.name}</text>
        <text x="${p.x}" y="${p.y+66}" text-anchor="middle" font-size="11" fill="#6B6B8A" font-family="sans-serif">${cat.breed}</text>
      </g>
    `;
  });

  svg.innerHTML = svgContent;
}

// Select cat
let currentCat = null;
function selectCat(id) {
  // Reset markers
  document.querySelectorAll('.cat-marker').forEach(m => m.classList.remove('active'));
  document.getElementById(`marker-${id}`)?.classList.add('active');

  const cat = cats[id];
  currentCat = id;

  document.getElementById('panel-empty').style.display = 'none';
  const profile = document.getElementById('cat-profile');
  profile.classList.add('visible');

  document.getElementById('profile-img').src = cat.img;
  document.getElementById('profile-img').onerror = function() {
    this.src = `data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><rect width='120' height='120' rx='60' fill='${encodeURIComponent(cat.color)}'/><text x='60' y='75' text-anchor='middle' font-size='50'>🐱</text></svg>`;
  };
  document.getElementById('profile-name').textContent = cat.name;
  document.getElementById('profile-nickname').textContent = cat.nickname;
  
  const badgesEl = document.getElementById('profile-badges');
  badgesEl.innerHTML = cat.badges.map(b => `<span class="badge">${b}</span>`).join('');

  const infoGrid = document.getElementById('profile-info-grid');
  infoGrid.innerHTML = `
    <div class="info-item"><div class="info-label">品种</div><div class="info-value">${cat.breed}</div></div>
    <div class="info-item"><div class="info-label">性别</div><div class="info-value">${cat.gender}</div></div>
    <div class="info-item"><div class="info-label">年龄</div><div class="info-value">${cat.age}</div></div>
    <div class="info-item"><div class="info-label">体重</div><div class="info-value">${cat.weight}</div></div>
    <div class="info-item" style="grid-column:span 2"><div class="info-label">状态</div><div class="info-value">${cat.status}</div></div>
  `;

  const locsEl = document.getElementById('profile-locations');
  locsEl.innerHTML = cat.locations.map(l => `<span class="location-tag">📍 ${l}</span>`).join('');

  document.getElementById('profile-personality').textContent = cat.personality;

  const relsEl = document.getElementById('profile-relations');
  relsEl.innerHTML = cat.relations.map(rel => {
    const relCat = cats[rel.catId];
    return `
      <div class="rel-item" onclick="selectCat(${rel.catId})">
        <img class="rel-avatar" src="${relCat.img}" alt="${relCat.name}" onerror="this.src='data:image/svg+xml,<svg xmlns=\\'http://www.w3.org/2000/svg\\' width=\\'36\\' height=\\'36\\'><rect width=\\'36\\' height=\\'36\\' rx=\\'18\\' fill=\\'${encodeURIComponent(relCat.color)}\\'/><text x=\\'18\\' y=\\'24\\' text-anchor=\\'middle\\' font-size=\\'18\\'>🐱</text></svg>'"/>
        <div class="rel-info">
          <div class="rel-name">${relCat.name}</div>
          <div class="rel-type">${rel.type} · ${rel.desc}</div>
        </div>
        <div class="rel-emoji">${rel.emoji}</div>
      </div>
    `;
  }).join('');

  document.getElementById('profile-rescue').textContent = cat.rescue;
}

// Switch views
function switchView(view) {
  document.getElementById('view-map').style.display = view === 'map' ? 'flex' : 'none';
  document.getElementById('view-gallery').style.display = view === 'gallery' ? 'block' : 'none';
  document.getElementById('view-relations').style.display = view === 'relations' ? 'block' : 'none';

  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  document.getElementById(`tab-${view}`).classList.add('active');

  if (view === 'gallery') renderGallery();
  if (view === 'relations') setTimeout(renderRelations, 50);
}

// Init
renderGallery();
</script>
</body>
</html>

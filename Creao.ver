
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>清华大学校园猫咪图鉴 🐱</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  
  :root {
    --purple: #6B2FE0;
    --purple-light: #9B6FFF;
    --purple-pale: #F0EAFF;
    --teal: #00B4B4;
    --gold: #C9A227;
    --bg: #F7F5FF;
    --card-bg: #FFFFFF;
    --text: #2D1B69;
    --text-light: #6B6B8A;
    --border: #E8E0FF;
  }

  body {
    font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
    background: var(--bg);
    color: var(--text);
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* Header */
  header {
    background: linear-gradient(135deg, #4A0FA8 0%, #6B2FE0 50%, #9B6FFF 100%);
    color: white;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: 0 2px 12px rgba(107,47,224,0.3);
    z-index: 100;
    flex-shrink: 0;
  }

  .header-logo {
    font-size: 32px;
    animation: float 3s ease-in-out infinite;
  }
  @keyframes float {
    0%,100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  .header-title h1 {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 2px;
  }
  .header-title p {
    font-size: 12px;
    opacity: 0.8;
    margin-top: 2px;
  }

  .header-stats {
    margin-left: auto;
    display: flex;
    gap: 20px;
  }
  .stat-item {
    text-align: center;
  }
  .stat-num {
    font-size: 22px;
    font-weight: 700;
  }
  .stat-label {
    font-size: 11px;
    opacity: 0.75;
  }

  /* Nav Tabs */
  .nav-tabs {
    display: flex;
    background: white;
    border-bottom: 2px solid var(--border);
    padding: 0 24px;
    gap: 4px;
    flex-shrink: 0;
  }
  .nav-tab {
    padding: 10px 20px;
    cursor: pointer;
    font-size: 14px;
    color: var(--text-light);
    border-bottom: 3px solid transparent;
    transition: all 0.2s;
    margin-bottom: -2px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav-tab:hover { color: var(--purple); }
  .nav-tab.active {
    color: var(--purple);
    border-bottom-color: var(--purple);
    font-weight: 600;
  }

  /* Main Layout */
  .main-content {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  /* ===== MAP VIEW ===== */
  #view-map {
    display: flex;
    width: 100%;
    height: 100%;
  }

  .map-container {
    flex: 1;
    position: relative;
    overflow: hidden;
    background: linear-gradient(145deg, #EAF4E8 0%, #D4ECD1 100%);
  }

  .campus-map {
    width: 100%;
    height: 100%;
  }

  /* Cat markers */
  .cat-marker {
    cursor: pointer;
    transition: transform 0.2s;
    filter: drop-shadow(0 2px 6px rgba(0,0,0,0.25));
  }
  .cat-marker:hover { transform: scale(1.2); }
  .cat-marker.active { transform: scale(1.25); }

  .marker-bubble {
    animation: bounce 2s ease-in-out infinite;
  }
  @keyframes bounce {
    0%,100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  .marker-pulse {
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,100% { opacity: 0.6; r: 18px; }
    50% { opacity: 0.2; r: 24px; }
  }

  /* Cat Info Panel */
  .cat-panel {
    width: 340px;
    background: white;
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .panel-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--text-light);
    gap: 12px;
    padding: 24px;
    text-align: center;
  }
  .panel-empty .big-emoji { font-size: 64px; }
  .panel-empty p { font-size: 14px; line-height: 1.6; }

  .cat-profile { display: none; flex-direction: column; height: 100%; }
  .cat-profile.visible { display: flex; }

  .cat-hero {
    background: linear-gradient(135deg, #4A0FA8, #9B6FFF);
    padding: 20px;
    text-align: center;
    position: relative;
    color: white;
    flex-shrink: 0;
  }

  .cat-hero img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 4px solid rgba(255,255,255,0.4);
    object-fit: cover;
    background: rgba(255,255,255,0.2);
  }

  .cat-hero h2 {
    font-size: 22px;
    font-weight: 700;
    margin-top: 10px;
  }
  .cat-hero .cat-nickname {
    font-size: 13px;
    opacity: 0.85;
    margin-top: 2px;
  }

  .cat-badges {
    display: flex;
    gap: 6px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  .badge {
    background: rgba(255,255,255,0.25);
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 20px;
    padding: 3px 10px;
    font-size: 11px;
  }

  .cat-details {
    padding: 16px;
    flex: 1;
    overflow-y: auto;
  }

  .detail-section {
    margin-bottom: 16px;
  }
  .section-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--purple);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--border);
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .info-item {
    background: var(--purple-pale);
    border-radius: 8px;
    padding: 8px 10px;
  }
  .info-label {
    font-size: 11px;
    color: var(--text-light);
    margin-bottom: 2px;
  }
  .info-value {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }

  .location-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .location-tag {
    background: #E8F5E9;
    color: #2E7D32;
    border-radius: 12px;
    padding: 4px 10px;
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .personality-text {
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-light);
  }

  .relationship-list { display: flex; flex-direction: column; gap: 8px; }
  .rel-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px;
    background: var(--purple-pale);
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .rel-item:hover { background: #DDD5FF; }
  .rel-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--purple-light);
  }
  .rel-info { flex: 1; }
  .rel-name { font-size: 13px; font-weight: 600; }
  .rel-type { font-size: 11px; color: var(--text-light); }
  .rel-emoji { font-size: 16px; }

  /* ===== GALLERY VIEW ===== */
  #view-gallery {
    display: none;
    padding: 24px;
    overflow-y: auto;
    width: 100%;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }

  .gallery-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(107,47,224,0.1);
    transition: transform 0.2s, box-shadow 0.2s;
    cursor: pointer;
    border: 1px solid var(--border);
  }
  .gallery-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(107,47,224,0.2);
  }

  .gallery-card-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  .gallery-card-body { padding: 14px; }
  .gallery-card-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
  }
  .gallery-card-sub {
    font-size: 12px;
    color: var(--text-light);
    margin-top: 2px;
    margin-bottom: 10px;
  }
  .gallery-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .gallery-tag {
    background: var(--purple-pale);
    color: var(--purple);
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 11px;
  }

  /* ===== RELATIONSHIP VIEW ===== */
  #view-relations {
    display: none;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  #relation-svg {
    width: 100%;
    height: 100%;
  }

  .relation-legend {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background: white;
    border-radius: 12px;
    padding: 12px 16px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.1);
    border: 1px solid var(--border);
  }
  .legend-title {
    font-size: 12px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 8px;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--text-light);
    margin-bottom: 4px;
  }
  .legend-line {
    width: 30px;
    height: 3px;
    border-radius: 2px;
  }

  /* Tooltip */
  .tooltip {
    position: fixed;
    background: rgba(45,27,105,0.9);
    color: white;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 12px;
    pointer-events: none;
    z-index: 1000;
    display: none;
  }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #C4B5FD; border-radius: 3px; }
</style>
</head>
<body>

<header>
  <div class="header-logo">🐱</div>
  <div class="header-title">
    <h1>清华大学校园猫咪图鉴</h1>
    <p>清华大学小动物保护协会 · 用爱守护每一只校园猫</p>
  </div>
  <div class="header-stats">
    <div class="stat-item">
      <div class="stat-num">6</div>
      <div class="stat-label">已建档猫咪</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">8</div>
      <div class="stat-label">活动区域</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">2024</div>
      <div class="stat-label">建档年份</div>
    </div>
  </div>
</header>

<div class="nav-tabs">
  <div class="nav-tab active" onclick="switchView('map')" id="tab-map">🗺️ 校园地图</div>
  <div class="nav-tab" onclick="switchView('gallery')" id="tab-gallery">📋 猫咪图鉴</div>
  <div class="nav-tab" onclick="switchView('relations')" id="tab-relations">🔗 关系图谱</div>
</div>

<div class="main-content">

  <!-- MAP VIEW -->
  <div id="view-map">
    <div class="map-container">
      <svg class="campus-map" viewBox="0 0 900 620" xmlns="http://www.w3.org/2000/svg">
        <!-- Background grass -->
        <rect width="900" height="620" fill="#C8DFC4"/>
        
        <!-- Main roads -->
        <rect x="0" y="280" width="900" height="22" fill="#E8E0C8" opacity="0.9"/>
        <rect x="430" y="0" width="22" height="620" fill="#E8E0C8" opacity="0.9"/>
        <rect x="0" y="450" width="900" height="16" fill="#E8E0C8" opacity="0.8"/>
        <rect x="200" y="0" width="16" height="620" fill="#E8E0C8" opacity="0.8"/>
        <rect x="680" y="0" width="16" height="620" fill="#E8E0C8" opacity="0.8"/>

        <!-- Road labels -->
        <text x="450" y="274" text-anchor="middle" font-size="10" fill="#8B7D5A" font-family="sans-serif">学堂路</text>
        <text x="437" y="440" text-anchor="middle" font-size="10" fill="#8B7D5A" font-family="sans-serif" transform="rotate(-90, 437, 440)">清华路</text>

        <!-- Lotus Pond 荷塘 -->
        <ellipse cx="300" cy="190" rx="90" ry="60" fill="#7EC8E3" opacity="0.75"/>
        <ellipse cx="300" cy="190" rx="75" ry="48" fill="#5BB8D4" opacity="0.5"/>
        <!-- Lotus leaves -->
        <circle cx="270" cy="175" r="12" fill="#5DA862" opacity="0.6"/>
        <circle cx="310" cy="160" r="10" fill="#5DA862" opacity="0.5"/>
        <circle cx="330" cy="200" r="14" fill="#5DA862" opacity="0.6"/>
        <circle cx="280" cy="215" r="11" fill="#5DA862" opacity="0.5"/>
        <text x="300" y="195" text-anchor="middle" font-size="13" fill="#1A6B8A" font-weight="bold" font-family="sans-serif">荷塘月色</text>

        <!-- 工字厅 Gongziting -->
        <rect x="130" y="140" width="80" height="55" rx="4" fill="#B5946A"/>
        <rect x="138" y="148" width="64" height="39" rx="2" fill="#C9A87C"/>
        <polygon points="130,140 210,140 170,118" fill="#8B6040"/>
        <text x="170" y="215" text-anchor="middle" font-size="12" fill="#5C3A1E" font-weight="bold" font-family="sans-serif">工字厅</text>

        <!-- 大礼堂 Auditorium -->
        <rect x="370" y="100" width="120" height="80" rx="6" fill="#C09060"/>
        <rect x="382" y="112" width="96" height="56" rx="3" fill="#D4A870"/>
        <ellipse cx="430" cy="100" rx="50" ry="22" fill="#A07040"/>
        <circle cx="430" cy="88" r="8" fill="#8B5E30"/>
        <text x="430" y="205" text-anchor="middle" font-size="12" fill="#5C3A1E" font-weight="bold" font-family="sans-serif">大礼堂</text>

        <!-- 清华学堂 -->
        <rect x="580" y="110" width="90" height="70" rx="4" fill="#B8A080"/>
        <polygon points="580,110 670,110 625,88" fill="#9A7855"/>
        <rect x="590" y="120" width="70" height="50" rx="2" fill="#C8B090"/>
        <text x="625" y="205" text-anchor="middle" font-size="12" fill="#5C3A1E" font-weight="bold" font-family="sans-serif">清华学堂</text>

        <!-- 图书馆 Library -->
        <rect x="480" y="310" width="140" height="100" rx="6" fill="#9E7DC0"/>
        <rect x="492" y="322" width="116" height="76" rx="3" fill="#B090D4"/>
        <polygon points="480,310 620,310 550,285" fill="#7A5A9E"/>
        <text x="550" y="230" text-anchor="middle" font-size="12" fill="white" font-weight="bold" font-family="sans-serif">图书馆</text>
        <!-- Library windows -->
        <rect x="500" y="333" width="16" height="20" rx="2" fill="#DDD0F0" opacity="0.7"/>
        <rect x="525" y="333" width="16" height="20" rx="2" fill="#DDD0F0" opacity="0.7"/>
        <rect x="550" y="333" width="16" height="20" rx="2" fill="#DDD0F0" opacity="0.7"/>
        <rect x="575" y="333" width="16" height="20" rx="2" fill="#DDD0F0" opacity="0.7"/>
        <rect x="600" y="333" width="10" height="20" rx="2" fill="#DDD0F0" opacity="0.7"/>

        <!-- 主楼 Main Building -->
        <rect x="355" y="320" width="60" height="100" rx="4" fill="#7A9ABA"/>
        <rect x="325" y="360" width="120" height="60" rx="4" fill="#8AAAC8"/>
        <polygon points="355,320 415,320 385,300" fill="#5A7A9A"/>
        <text x="385" y="445" text-anchor="middle" font-size="12" fill="#2A4A6A" font-weight="bold" font-family="sans-serif">主楼</text>
        <!-- Windows -->
        <rect x="365" y="330" width="10" height="14" rx="1" fill="#C8DDF0" opacity="0.8"/>
        <rect x="382" y="330" width="10" height="14" rx="1" fill="#C8DDF0" opacity="0.8"/>
        <rect x="399" y="330" width="10" height="14" rx="1" fill="#C8DDF0" opacity="0.8"/>

        <!-- 体育馆 Gymnasium -->
        <ellipse cx="760" cy="360" rx="80" ry="55" fill="#A0B870"/>
        <ellipse cx="760" cy="360" rx="66" ry="43" fill="#B8CC88"/>
        <text x="760" y="365" text-anchor="middle" font-size="12" fill="#3A5A1A" font-weight="bold" font-family="sans-serif">综合体育馆</text>

        <!-- 紫荆园食堂 Canteen -->
        <rect x="120" y="340" width="120" height="80" rx="6" fill="#E8A060"/>
        <rect x="130" y="350" width="100" height="60" rx="3" fill="#F0B878"/>
        <text x="180" y="400" text-anchor="middle" font-size="12" fill="#7A3A00" font-weight="bold" font-family="sans-serif">紫荆园食堂</text>

        <!-- 宿舍区 Dorms -->
        <rect x="60" y="480" width="200" height="110" rx="6" fill="#D4B8C0"/>
        <rect x="70" y="490" width="80" height="90" rx="3" fill="#E0C8CC"/>
        <rect x="162" y="490" width="80" height="90" rx="3" fill="#E0C8CC"/>
        <text x="160" y="545" text-anchor="middle" font-size="12" fill="#6A3A4A" font-weight="bold" font-family="sans-serif">紫荆学生公寓</text>

        <!-- 二教 -->
        <rect x="640" y="310" width="80" height="70" rx="4" fill="#C8A060"/>
        <rect x="650" y="320" width="60" height="50" rx="2" fill="#D8B070"/>
        <text x="680" y="400" text-anchor="middle" font-size="12" fill="#5A3A10" font-weight="bold" font-family="sans-serif">第二教学楼</text>

        <!-- Trees scattered -->
        <g opacity="0.8">
          <circle cx="80" cy="250" r="16" fill="#4A8B3A"/>
          <circle cx="108" cy="248" r="13" fill="#5A9B4A"/>
          <circle cx="90" cy="235" r="11" fill="#3A7B2A"/>
          
          <circle cx="780" cy="200" r="16" fill="#4A8B3A"/>
          <circle cx="808" cy="198" r="13" fill="#5A9B4A"/>
          
          <circle cx="500" cy="230" r="14" fill="#4A8B3A"/>
          <circle cx="525" cy="228" r="11" fill="#5A9B4A"/>

          <circle cx="260" cy="380" r="13" fill="#4A8B3A"/>
          <circle cx="240" cy="370" r="10" fill="#5A9B4A"/>
          
          <circle cx="700" cy="450" r="15" fill="#4A8B3A"/>
          <circle cx="725" cy="448" r="12" fill="#5A9B4A"/>

          <circle cx="840" cy="120" r="16" fill="#4A8B3A"/>
          <circle cx="860" cy="115" r="12" fill="#5A9B4A"/>

          <circle cx="150" cy="500" r="0" fill="transparent"/>
        </g>

        <!-- Paths between buildings -->
        <path d="M 170 195 Q 200 230 180 300" stroke="#E8E0C8" stroke-width="8" fill="none" opacity="0.7"/>
        <path d="M 430 180 Q 430 230 430 280" stroke="#E8E0C8" stroke-width="8" fill="none" opacity="0.7"/>

        <!-- ======================== CAT MARKERS ======================== -->

        <!-- 橘福 @ 紫荆园食堂 (180, 330) -->
        <g class="cat-marker" onclick="selectCat(0)" id="marker-0">
          <circle class="marker-pulse" cx="180" cy="328" r="20" fill="#FF8C00" opacity="0.3"/>
          <circle cx="180" cy="328" r="18" fill="#FF8C00"/>
          <circle cx="180" cy="328" r="15" fill="#FFA040"/>
          <text x="180" y="333" text-anchor="middle" font-size="16">🐱</text>
          <rect x="148" y="298" width="64" height="20" rx="10" fill="rgba(0,0,0,0.65)"/>
          <text x="180" y="312" text-anchor="middle" font-size="11" fill="white" font-family="sans-serif">橘福 · 橘猫</text>
        </g>

        <!-- 雪团 @ 图书馆 (550, 370) -->
        <g class="cat-marker" onclick="selectCat(1)" id="marker-1">
          <circle class="marker-pulse" cx="550" cy="365" r="20" fill="#A0A0FF" opacity="0.3"/>
          <circle cx="550" cy="365" r="18" fill="#7B5EA7"/>
          <circle cx="550" cy="365" r="15" fill="#9B7EC8"/>
          <text x="550" y="370" text-anchor="middle" font-size="16">🐱</text>
          <rect x="518" y="338" width="64" height="20" rx="10" fill="rgba(0,0,0,0.65)"/>
          <text x="550" y="352" text-anchor="middle" font-size="11" fill="white" font-family="sans-serif">雪团 · 白猫</text>
        </g>

        <!-- 月月 @ 荷塘 (300, 190) -->
        <g class="cat-marker" onclick="selectCat(2)" id="marker-2">
          <circle class="marker-pulse" cx="300" cy="245" r="20" fill="#FF6EA0" opacity="0.3"/>
          <circle cx="300" cy="245" r="18" fill="#E05080"/>
          <circle cx="300" cy="245" r="15" fill="#F07090"/>
          <text x="300" y="250" text-anchor="middle" font-size="16">🐱</text>
          <rect x="262" y="218" width="76" height="20" rx="10" fill="rgba(0,0,0,0.65)"/>
          <text x="300" y="232" text-anchor="middle" font-size="11" fill="white" font-family="sans-serif">月月 · 三花猫</text>
        </g>

        <!-- 茶叶 @ 工字厅 (170, 150) -->
        <g class="cat-marker" onclick="selectCat(3)" id="marker-3">
          <circle class="marker-pulse" cx="170" cy="148" r="20" fill="#50C878" opacity="0.3"/>
          <circle cx="170" cy="148" r="18" fill="#2E7D32"/>
          <circle cx="170" cy="148" r="15" fill="#4CAF50"/>
